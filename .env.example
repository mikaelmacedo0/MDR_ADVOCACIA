# =====================================================================
# JurisAcompanha — Variáveis de Ambiente de Exemplo
# =====================================================================
# ATENÇÃO: NUNCA coloque chaves secretas ou de serviço (service_role) neste arquivo
# ou em qualquer arquivo do front-end.
# =====================================================================

# URL do projeto Supabase (obtenha em Project Settings -> API)
VITE_SUPABASE_URL=https://seu-projeto-jurisacompanha.supabase.co

# Chave anônima pública (anon key / publishable key)
VITE_SUPABASE_ANON_KEY=sua-chave-anonima-publica-aqui

# Modo de simulação para desenvolvimento local caso as credenciais não estejam configuradas:
# true = utiliza repositório simulado em memória com dados fictícios de demonstração multi-tenant
# false = conecta estritamente ao Supabase informado acima
VITE_ENABLE_MOCK_FALLBACK=true
